APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 业务依赖 PostgreSQL 18 及 vector、pg_trgm、zhparser 扩展，不支持 SQLite（测试内存库除外）。
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=novel_forge_app
DB_USERNAME=novel_forge_app
DB_PASSWORD=
DB_PREFIX="n_"
# 中文词典通过连接启动参数加载，留空时不传入。
DB_ZHPARSER_EXTRA_DICTS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 设定、大纲、正文与提交走 Redis；导出走 database 连接的 novel-exports 队列。
# 需要常驻三个消费者：redis 默认队列、redis_content_acceptance 的 content-acceptance 队列、database 的 novel-exports 队列。
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_PREFIX=novelforge_
REDIS_DB=0
REDIS_CACHE_DB=1
NOVELFORGE_SEARCH_DRIVER=pg_jieba
NOVELFORGE_SEARCH_CONFIG=novelforge_zh

REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI 相关（根据实际 Provider）
OPENAI_API_KEY=
# A03 使用 SDK 原生 OpenAI 路由；真实验收需在本机填写有效密钥。
OPENAI_URL=https://api.openai.com/v1
# DeepSeek文本请求：模型名以deepseek-开头时使用此凭据，不复用OpenAI密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/v1
